MONGODB_URI=mongodb://127.0.0.1:27017/tn_schemes
MONGODB_FALLBACK=true
PORT=3000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_GROUNDING_MODEL=gemini-3.5-flash
GEMINI_BACKGROUND_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_CALLS_PER_DAY=200
GEMINI_RESERVE_FOR_CHAT_PERCENT=30
RUN_JOBS_ON_START=false
ENABLE_SCHEDULER=false
ENABLE_DISCOVERY=false
AI_MODE=auto
ADMIN_KEY=your_secret_admin_key

# Auth & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# SMTP Email Configuration (Optional - Console fallback in dev if omitted)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=noreply@tn.gov.in